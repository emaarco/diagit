{
  "name": "diagit",
  "version": "0.0.0",
  "private": true,
  "description": "Browser extension that renders and diffs diagram models (BPMN, DMN, Wardley Maps, Team Topologies, Event Storming, Context Maps, Value Chains) inline on GitLab & GitHub — plus a standalone viewer.",
  "type": "module",
  "license": "MIT",
  "author": "Marco Schäck (https://github.com/emaarco)",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/bpmn-diff",
    "packages/extension"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "dev": "npm run dev -w @diagit/extension",
    "dev:example": "npm run dev:example -w @diagit/extension",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "npm run test:e2e -w @diagit/extension --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "lint:deps": "npm run lint:deps --workspaces --if-present",
    "knip": "knip",
    "knip:fix": "knip --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "knip": "6.41.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2"
  }
}
